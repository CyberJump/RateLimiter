# Multi-stage Dockerfile for Gateway Node
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src/ ./src/

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install ca-certificates, curl, and the static k6 binary
RUN apk add --no-cache ca-certificates curl && \
    curl -L -s -o k6.tar.gz https://github.com/grafana/k6/releases/download/v0.50.0/k6-v0.50.0-linux-amd64.tar.gz && \
    tar -xzf k6.tar.gz && \
    mv k6-v0.50.0-linux-amd64/k6 /usr/bin/k6 && \
    rm -rf k6.tar.gz k6-v0.50.0-linux-amd64

COPY package*.json ./
RUN npm ci --only=production

COPY --from=builder /app/dist ./dist
COPY src/rate-limiters/lua ./dist/rate-limiters/lua
COPY src/rate-limiters/lua ./src/rate-limiters/lua
COPY benchmarks ./benchmarks

EXPOSE 3000

CMD ["node", "dist/server.js"]
